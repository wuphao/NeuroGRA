# Copy values into environment variables or the ignored local settings file.
# Application home (optional; defaults to the launcher's working directory)
NEUROGRA_HOME=

# RWE credentials; never commit real values. Environment overrides .env.rwe.local.
RWE_API_BASE_URL=http://localhost:8081
RWE_LOGIN_ACCOUNT=
RWE_LOGIN_PASSWORD=
RWE_API_TOKEN=
RWE_PROJECT_ID=8
RWE_DB_HOST=localhost
RWE_DB_PORT=5432
RWE_DB_NAME=rwe_nexus_develop
RWE_DB_USER=postgres
RWE_DB_PASSWORD=

# Neo4j authentication; service/model URLs belong in the selected YAML config.
NEUROGRA_KG_NEO4J_PASSWORD=
