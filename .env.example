# Copy this file to .env and fill in local values.
# Never commit real secrets.

# LLM / embedding service
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=

# Local paths
NEUROGRA_DATA_DIR=./data
NEUROGRA_OUTPUT_DIR=./output

# Optional storage backends
VECTOR_STORE_PATH=./data/vector_store
GRAPH_STORE_PATH=./data/graph_store
