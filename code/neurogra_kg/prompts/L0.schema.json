      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "facts",
    "issues"
  ],
  "title": "FactOutput",
  "type": "object"
}
