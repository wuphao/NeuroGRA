# Copy to .env.llm.local in the NeuroGRA workspace. Fill only the keys you use.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# true permits the selected non-local model to receive patient prompts and tool data.
# Model discovery and the fixed-text connectivity test do not use patient data.
LLM_ALLOW_EXTERNAL_PATIENT_DATA=false
